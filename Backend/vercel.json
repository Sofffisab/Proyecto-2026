{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/jobs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/cron/qr-rotate",
      "schedule": "0 12 * * *"
    }
  ]
}
