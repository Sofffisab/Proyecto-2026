generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Main goal — multi-select.
enum MainGoal {
  LOSE_WEIGHT
  GAIN_MUSCLE
  IMPROVE_HEALTH
  INCREASE_ENDURANCE
}

// Current experience level — single select.
enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Weekly training days — single select, 6 fixed buckets.
enum TrainingFrequency {
  ONE_TO_TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
}

// Desired training type — HOW they want to train, not WHY (that's MainGoal).
// Single select.
enum TrainingType {
  STRENGTH
  CARDIO
  FUNCTIONAL
  MIXED
}

enum Role {
  ADMIN
  TRAINER
  USER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum GoalType {
  WEIGHT
  MUSCLE
  FAT
  PHYSICAL_HEALTH
  MENTAL_HEALTH
  STRENGTH
  ENDURANCE
  COMMITMENT
  MOBILITY
  NONE
  OTHER
}

enum GoalAction {
  GAIN
  LOSE
  MAINTAIN
}

enum GoalDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AssistanceStatus {
  PENDING
  ASSIGNED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RoutineRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum SocialChallengeStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  COMPLETED
  EXPIRED
}

enum TrainerNoteVisibility {
  PUBLIC
  PRIVATE
}

enum TrainerAvailabilityStatus {
  AVAILABLE
  BUSY
}

enum ComplaintStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintSource {
  USER            // Reported by another member
  TRAINER_REPORT  // Reported by a trainer against a member (equipment damage, misconduct, etc.)
  AUTO_NO_HELP    // Auto-generated when a member marks "No me ayudaron" on the rate-trainer popup
  AUTO_MACHINE_CONFLICT // Auto-generated when 2 users show open usage on the same machine and no trainer verified in time
}

// How a MachineConflict ("2 people on the same machine") was ultimately
// resolved. UNVERIFIED means no trainer verified in time — see
// machineConflict.job.js#expireUnverifiedConflicts.
enum MachineConflictResolution {
  BOTH_PRESENT     // Trainer confirms both users are actually there
  NEITHER_PRESENT  // Trainer confirms neither user is actually there
  ONLY_FIRST       // Trainer confirms only the first (earlier) usage's user is there
  ONLY_SECOND      // Trainer confirms only the second (later) usage's user is there
  UNVERIFIED       // No trainer verified before the timeout — auto-closed
}

enum RewardRedemptionStatus {
  SHIPPED
  DELIVERED
}

// What area of activity a badge celebrates. Purely descriptive/grouping —
// doesn't affect how the achievement is evaluated (see AchievementMetric).
enum AchievementCategory {
  CONSISTENCY // Attendance streaks (days/weeks/months in a row at the gym)
  SOCIAL      // Social interactions / challenges completed with other members
  MACHINE     // Machine usage
  POINTS      // Legacy: total accumulated points (kept for existing data)
}

// The concrete measurement an achievement's `threshold` is checked against.
// See achievementMetrics.service.js for how each one is computed.
enum AchievementMetric {
  STREAK_DAYS          // Consecutive calendar days with a gym check-in
  STREAK_WEEKS         // Consecutive calendar weeks with at least one visit
  STREAK_MONTHS        // Consecutive calendar months with at least one visit
  SOCIAL_INTERACTIONS  // Total SocialInteraction rows (e.g. completed challenges)
  MACHINE_USES         // Total completed MachineUsage rows
  TOTAL_POINTS         // Legacy: sum of PointTransaction.points (uses pointsRequired)
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  firstName            String
  lastName             String
  birthday             DateTime?
  gender               Gender?
  role                 Role      @default(USER)
  // Minimal-profile screen (4 fixed-option fields)
  trainingLevel        ExperienceLevel?
  objectives           MainGoal[]
  weeklyTrainingDays   TrainingFrequency?
  trainingType         TrainingType?
  medicalConditions    Json?
  deliveryAddress      String?
  fcmToken             String?
  isActive             Boolean   @default(true)
  // Set once birthday, medicalConditions and deliveryAddress are all filled in.
  // Regular members are blocked from the rest of the API until this is true —
  // see requireCompleteProfile middleware.
  isProfileComplete    Boolean   @default(false)
  // Throttles the "see a doctor/nutritionist" recommendation email so it is
  // sent at most once per cooldown window, even though the check runs daily.
  lastHealthEmailAt    DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  settings             UserSettings?
  trainerProfile       TrainerProfile?
  gymSessions          GymSession[]
  machineUsages        MachineUsage[]
  assistanceRequests   Assistance[]        @relation("AssistanceUser")
  trainerAssistances   Assistance[]        @relation("AssistanceTrainer")
  trainerNotes         TrainerNote[]       @relation("TrainerNotesAuthor")
  userNotes            TrainerNote[]       @relation("TrainerNotesUser")
  ratingsReceived      TrainerRating[]     @relation("TrainerRatingsTrainer")
  ratingsSent          TrainerRating[]     @relation("TrainerRatingsUser")
  routines             Routine[]
  routineRequests      RoutineRequest[]    @relation("RoutineRequestUser")
  assignedRoutines     RoutineRequest[]    @relation("RoutineRequestTrainer")
  goals                Goal[]
  progressEntries      ProgressEntry[]
  pointTransactions    PointTransaction[]
  achievements         UserAchievement[]
  rewardRedemptions    RewardRedemption[]
  rewardPendingGrants  RewardPendingGrant[]
  socialChallenges     SocialChallenge[]   @relation("ChallengeOwner")
  socialPartners       SocialChallenge[]   @relation("ChallengePartner")
  socialInteractions   SocialInteraction[] @relation("SocialUser")
  socialTargets        SocialInteraction[] @relation("SocialTarget")
  complaintsCreated    Complaint[]         @relation("ComplaintReporter")
  complaintsReceived   Complaint[]         @relation("ComplaintReported")
  complaintsReviewed   Complaint[]         @relation("ComplaintReviewer")
  reviewRequests       PointReviewRequest[] @relation("ReviewRequestUser")
  reviewedRequests     PointReviewRequest[] @relation("ReviewRequestReviewer")
  notifications        Notification[]
  wrappeds             Wrapped[]
  behaviorProfile      UserBehaviorProfile?
  machineConflictsAsFirst  MachineConflict[] @relation("MachineConflictFirstUser")
  machineConflictsAsSecond MachineConflict[] @relation("MachineConflictSecondUser")
  machineConflictsResolved MachineConflict[] @relation("MachineConflictResolver")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// Cached output of the behavior-pattern learning engine (see
// behaviorAnalysis.service.js). Recomputed periodically by the analytics
// cron job so that reads (dashboard, difficulty/points engine) are cheap
// and don't re-scan the user's whole session history on every request.
model UserBehaviorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  sessionCount        Int      @default(0)
  // Per-weekday frequency + share of total sessions, e.g.
  // [{ day: 1, name: "Monday", count: 12, share: 0.35 }, ...]
  frequentDays        Json?
  // Most common check-in hour (0-23), null if not enough data.
  preferredHour       Int?
  // Most used machines, e.g. [{ name: "Treadmill", count: 20 }, ...]
  topMachines         Json?
  // Detected recurring routines: groups of sessions that repeat the same
  // (or near-identical) set of machines, e.g.
  // [{ signature: ["Treadmill","Bench Press"], occurrences: 8, lastSeenAt }]
  routines            Json?
  // 0 (very irregular) .. 1 (perfectly regular) based on how consistent the
  // gaps between sessions are relative to the user's own average cadence.
  consistencyScore    Float?
  avgSessionsPerWeek  Float?
  calculatedAt        DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  disableAssistance Boolean  @default(false)
  disableSocial     Boolean  @default(false)
  trainerPreference String?
  machineTrackingOptOut Boolean @default(false)
  analyticsConsent  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainerProfile {
  id                   String                    @id @default(uuid())
  userId               String                    @unique
  specialties          String[]
  averageRating        Float                     @default(0)
  totalRatings         Int                       @default(0)
  availability         TrainerAvailabilityStatus @default(AVAILABLE)
  availabilityUpdatedAt DateTime                 @default(now())
  pendingAlertAssistanceId String?
  pendingAlertAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt             DateTime                 @updatedAt

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GymSession {
  id              String    @id @default(uuid())
  userId          String
  checkInAt       DateTime
  checkOutAt      DateTime?
  durationMinutes Int?
  autoClosed      Boolean   @default(false)
  createdAt       DateTime  @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineUsages   MachineUsage[]
  ratings         TrainerRating[]
  complaints      Complaint[]

  @@index([userId])
  @@index([checkInAt])
}

model Machine {
  id               String   @id @default(uuid())
  name             String
  zone             String?  // Physical area/station in the gym (e.g. "Zona de pesas", "Cardio 2") — used to tell a trainer where a student is standing.
  qrToken          String   @unique
  qrTokenUpdatedAt DateTime @default(now())
  // Grace window support: keeps the token that was replaced by the most
  // recent rotation, plus the instant it stops being accepted, so a scan
  // performed (or synced late) while it was still the current token is not
  // wrongly rejected just because rotation has since moved on. See
  // verification.service.js#processScan / #regenerateMachineQR.
  previousQrToken           String?
  previousQrTokenValidUntil DateTime?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  usages           MachineUsage[]
  conflicts        MachineConflict[]

  @@index([active])
}

// "Two people on the same machine": raised when a scan opens a new
// MachineUsage on a machine that already has a different user's usage
// open. Pushed to trainers to verify in person (machineConflict.service.js);
// verifying earns a small bonus (POINTS.TRAINER_ORDER_BONUS). If nobody
// verifies before the timeout, both usages stand as-is but a complaint is
// auto-raised against both (machineConflict.job.js#expireUnverifiedConflicts).
model MachineConflict {
  id             String                     @id @default(uuid())
  machineId      String
  firstUserId    String
  secondUserId   String
  firstUsageId   String
  secondUsageId  String
  detectedAt     DateTime                   @default(now())
  notifiedTrainers Boolean                  @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     MachineConflictResolution?

  machine        Machine       @relation(fields: [machineId],    references: [id], onDelete: Cascade)
  firstUser      User          @relation("MachineConflictFirstUser",  fields: [firstUserId],  references: [id], onDelete: Cascade)
  secondUser     User          @relation("MachineConflictSecondUser", fields: [secondUserId], references: [id], onDelete: Cascade)
  resolver       User?         @relation("MachineConflictResolver",   fields: [resolvedBy],   references: [id])

  @@index([machineId])
  @@index([resolvedAt])
}

model MachineUsage {
  id              String      @id @default(uuid())
  userId          String
  machineId       String
  gymSessionId    String?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine         Machine     @relation(fields: [machineId], references: [id])
  gymSession      GymSession? @relation(fields: [gymSessionId], references: [id])

  @@index([userId])
  @@index([machineId])
  @@index([gymSessionId])
  @@index([startedAt])
}

model Assistance {
  id          String           @id @default(uuid())
  userId      String
  trainerId   String?
  status      AssistanceStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  assignedAt  DateTime?
  completedAt DateTime?

  user        User  @relation("AssistanceUser",    fields: [userId],    references: [id], onDelete: Cascade)
  trainer     User? @relation("AssistanceTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trainerId])
  @@index([status])
}

model TrainerNote {
  id         String                @id @default(uuid())
  trainerId  String
  userId     String
  note       String
  visibility TrainerNoteVisibility @default(PRIVATE)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  trainer   User @relation("TrainerNotesAuthor", fields: [trainerId], references: [id], onDelete: Cascade)
  user      User @relation("TrainerNotesUser",   fields: [userId],    references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([userId])
}

model TrainerRating {
  id           String      @id @default(uuid())
  trainerId    String
  userId       String
  gymSessionId String?
  rating       Int
  createdAt    DateTime    @default(now())

  trainer      User        @relation("TrainerRatingsTrainer", fields: [trainerId],    references: [id], onDelete: Cascade)
  user         User        @relation("TrainerRatingsUser",    fields: [userId],       references: [id], onDelete: Cascade)
  gymSession   GymSession? @relation(fields: [gymSessionId], references: [id])

  @@index([trainerId])
  @@index([userId])
}

model Routine {
  id        String   @id @default(uuid())
  userId    String
  name      String?
  isCustom  Boolean  @default(false)
  source    String   @default("MANUAL") // MANUAL | AI_SUGGESTED — where the routine came from
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RoutineRequest {
  id        String               @id @default(uuid())
  userId    String
  trainerId String?
  status    RoutineRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())

  user      User  @relation("RoutineRequestUser",    fields: [userId],    references: [id], onDelete: Cascade)
  trainer   User? @relation("RoutineRequestTrainer", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trainerId])
  @@index([status])
}

model Goal {
  id           String         @id @default(uuid())
  userId       String
  type         GoalType
  subType      String?
  unit         String?
  action       GoalAction
  targetValue  Float
  currentValue Float          @default(0)
  difficulty   GoalDifficulty @default(MEDIUM)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress     ProgressEntry[]

  @@index([userId])
  @@index([type])
}

model ProgressEntry {
  id              String   @id @default(uuid())
  userId          String
  goalId          String
  value           Float
  progressPercent Float
  note            String?
  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal @relation(fields: [goalId],  references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId])
}

model PointTransaction {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Achievement {
  id             String              @id @default(uuid())
  name           String
  description    String
  // Legacy field: only meaningful when metric = TOTAL_POINTS. Kept (rather
  // than dropped) so existing POINTS-category achievements keep working
  // unchanged. New streak/social/machine achievements use `threshold` below.
  pointsRequired Int                 @default(0)
  category       AchievementCategory @default(POINTS)
  metric         AchievementMetric   @default(TOTAL_POINTS)
  // Value the computed metric must reach to unlock this badge. E.g. metric
  // = STREAK_DAYS, threshold = 7 → "7-day attendance streak" badge.
  // Ignored for metric = TOTAL_POINTS (pointsRequired is used instead).
  threshold      Int                 @default(0)
  createdAt      DateTime            @default(now())

  users          UserAchievement[]

  @@index([category])
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user          User        @relation(fields: [userId],        references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model RewardPendingGrant {
  id                    String    @id @default(uuid())
  userId                String
  // Snapshot of the user's total points at the moment they qualified but no
  // reward was in stock. Purely informational for the admin queue — the
  // actual grant, when stock frees up, always re-reads live points (see
  // reward.service.js#fulfillPendingGrants), since the user may have kept
  // earning points while waiting.
  pointsAtQueueTime     Int
  createdAt             DateTime  @default(now())
  // Set once a matching reward becomes available and the grant actually
  // goes through (see fulfillPendingGrants). Null means still waiting.
  fulfilledAt           DateTime?
  fulfilledRedemptionId String?   @unique

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfilledRedemption   RewardRedemption?  @relation(fields: [fulfilledRedemptionId], references: [id])

  @@index([userId])
  @@index([fulfilledAt])
}

model Reward {
  id          String   @id @default(uuid())
  name        String
  description String?
  pointsCost  Int      @default(0)
  active      Boolean  @default(true)
  // Admin-only fields — never exposed on the user-facing /rewards endpoint.
  // Rewards are granted automatically at random among what is currently in
  // stock (see reward.service.js#autoGrantRewards), so users never see or
  // choose stock levels ahead of time.
  stock            Int     @default(0)
  // Marketing/merchandising prize (sponsored brand items, e.g. towels) as
  // opposed to a purely gym-funded reward. Admin-only classification, used
  // for reporting/reordering — not shown to users.
  isMarketingItem  Boolean @default(false)
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]

  @@index([active])
}

model RewardRedemption {
  id          String                 @id @default(uuid())
  userId      String
  rewardId    String
  status      RewardRedemptionStatus @default(SHIPPED)
  deliveredAt DateTime?
  createdAt   DateTime               @default(now())

  user        User   @relation(fields: [userId],   references: [id], onDelete: Cascade)
  reward      Reward @relation(fields: [rewardId], references: [id])
  pendingGrant RewardPendingGrant?

  @@index([userId])
  @@index([status])
}

model SocialChallenge {
  id            String                @id @default(uuid())
  userId        String
  partnerUserId String
  station       String?
  status        SocialChallengeStatus @default(ASSIGNED)
  expiresAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())

  user          User @relation("ChallengeOwner",   fields: [userId],        references: [id], onDelete: Cascade)
  partner       User @relation("ChallengePartner", fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([partnerUserId])
  @@index([status])
}

model SocialInteraction {
  id           String   @id @default(uuid())
  userId       String
  targetUserId String
  type         String
  createdAt    DateTime @default(now())

  user         User @relation("SocialUser",   fields: [userId],       references: [id], onDelete: Cascade)
  target       User @relation("SocialTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetUserId])
}

model Complaint {
  id             String          @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  message        String?
  status         ComplaintStatus @default(PENDING)
  source         ComplaintSource @default(USER)
  // Session the complaint is tied to, when relevant (e.g. the auto "no me
  // ayudaron" complaint generated from the rate-trainer popup).
  gymSessionId   String?
  reviewedBy     String?
  reviewedAt     DateTime?
  resolution     String?         // Auto-close message or admin note on resolution
  createdAt      DateTime        @default(now())

  reporter       User        @relation("ComplaintReporter", fields: [reporterId],     references: [id], onDelete: Cascade)
  reported       User        @relation("ComplaintReported", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewer       User?       @relation("ComplaintReviewer", fields: [reviewedBy],     references: [id])
  gymSession     GymSession? @relation(fields: [gymSessionId], references: [id])

  @@index([reportedUserId])
  @@index([status])
  @@index([gymSessionId])
}

model PointReviewRequest {
  id         String   @id @default(uuid())
  userId     String
  reason     String
  resolved   Boolean  @default(false)
  reviewedBy String?
  createdAt  DateTime @default(now())

  user       User  @relation("ReviewRequestUser",     fields: [userId],     references: [id], onDelete: Cascade)
  reviewer   User? @relation("ReviewRequestReviewer", fields: [reviewedBy], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Wrapped {
  id          String   @id @default(uuid())
  userId      String
  year        Int
  payload     Json
  generatedAt DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([year])
  @@unique([userId, year])
}